# ===========================
# SUPABASE (required)
# ===========================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===========================
# LLM PROVIDER (required for AI features)
# ===========================
# Supported providers: openai, anthropic, qwen
#
# --- For Qwen (Alibaba Cloud / DashScope) ---
LLM_PROVIDER=qwen
LLM_API_KEY=sk-your-dashscope-api-key
LLM_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
#
# --- For OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-key
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# --- For Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-key
# LLM_API_URL=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-4-20250514

# ===========================
# APP CONFIG (optional)
# ===========================
NEXT_PUBLIC_APP_URL=http://localhost:3001
